{
  "name": "fc-desktop-app",
  "version": "1.0.0",
  "description": "FC Software Hybrid Multi-Tenant Church Management Desktop Client",
  "main": "dist/main/main.js",
  "author": "FC Software Team",
  "license": "UNLICENSED",
  "scripts": {
    "dev:next": "next dev src/renderer -p 3080",
    "build:next": "next build src/renderer",
    "start:next": "next start src/renderer",
    "dev:electron": "tsc -p tsconfig.json && electron .",
    "build:electron": "tsc -p tsconfig.json",
    "dev": "concurrently -k \"npm run dev:next\" \"wait-on http://127.0.0.1:3080 && npm run dev:electron\"",
    "build": "npm run build:next && npm run build:electron",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac:universal": "npm run build && electron-builder --mac dmg --universal",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.18.0",
    "electron-serve": "^1.3.0",
    "electron-updater": "^6.1.4",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "sql.js": "^1.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "@types/sql.js": "^1.4.9",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1"
  }
}
