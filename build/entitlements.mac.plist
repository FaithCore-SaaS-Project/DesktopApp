<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Allow JIT compilation (required by Electron's V8 JavaScript engine) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow unsigned executable memory (required by some Electron internals) -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>

    <!-- Allow loading of dylibs with invalid signatures (required for native modules) -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network access for API calls -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Read/Write user-selected files (for PDF save dialog) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Downloads folder access (for saving documents) -->
    <key>com.apple.security.files.downloads.read-write</key>
    <true/>
  </dict>
</plist>
